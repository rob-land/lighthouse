# Build artifacts
_build/
_install/
_flatpak/
_flatpak_x86_64/
_flatpak_aarch64/
.flatpak-builder/
repo/
*.flatpak

# Debian packaging (debian/ itself is tracked; these are build output)
obj-*-linux-gnu/
debian/.debhelper/
debian/lighthouse/
debian/files
debian/debhelper-build-stamp
debian/*.substvars
debian/*.debhelper.log
*.deb
*.buildinfo
*.changes

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Claude workspace — track shared settings, ignore everything else
.claude/*
!.claude/settings.json

# Generated by flatpak-pip-generator (regenerated per build)
# python3-deps.json is committed (CI builds offline from it); keep the .bak out
build-aux/flatpak/python3-deps.json.bak
