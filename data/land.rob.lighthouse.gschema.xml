<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="land.rob.lighthouse" path="/land/rob/lighthouse/">
    <key name="window-width" type="i">
      <default>360</default>
      <summary>Window width in pixels</summary>
    </key>
    <key name="window-height" type="i">
      <default>760</default>
      <summary>Window height in pixels</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>

    <key name="device-name" type="s">
      <default>''</default>
      <summary>Display name advertised to peers (empty = hostname)</summary>
    </key>
    <key name="override-silent" type="b">
      <default>true</default>
      <summary>Ring at full volume even when the phone is silenced</summary>
    </key>
    <key name="ring-duration-seconds" type="i">
      <default>60</default>
      <summary>How long the beam rings before giving up</summary>
    </key>
  </schema>
</schemalist>
