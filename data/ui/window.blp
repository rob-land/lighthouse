using Gtk 4.0;
using Adw 1;

template $LighthouseWindow: Adw.ApplicationWindow {
  title: _("Lighthouse");
  default-width: 360;
  default-height: 760;
  width-request: 360;
  height-request: 360;

  content: Adw.BreakpointBin {
    width-request: 360;
    height-request: 360;

    Adw.Breakpoint {
      condition ("max-width: 600sp")
      setters {
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar header_bar {
        title-widget: Adw.WindowTitle window_title {
          title: _("Lighthouse");
        };

        [end]
        MenuButton {
          icon-name: "open-menu-symbolic";
          primary: true;
          menu-model: primary_menu;
          tooltip-text: _("Main Menu");
        }
      }

      content: Adw.ToastOverlay toast_overlay {
        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: _("This Phone");

            [header-suffix]
            Button test_ring_button {
              valign: center;
              label: _("Test Ring");

              styles [
                "suggested-action",
                "pill",
              ]
            }

            Adw.ActionRow status_row {
              title: _("Find-my agent");
              subtitle: _("Checking…");

              [prefix]
              Image status_icon {
                icon-name: "content-loading-symbolic";
              }
            }
          }

          Adw.PreferencesGroup peers_group {
            title: _("Devices");
            description: _("Devices on your network that can ring this phone");
          }
        };
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("About Lighthouse");
      action: "app.about";
    }
  }
}
